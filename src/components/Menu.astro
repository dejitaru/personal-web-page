---
import { Image } from 'astro:assets';
import carlosProfileImage from '../assets/carlos.jpg';
import carlosHoverImage from '../assets/carlos-hover.jpg';

const { currentPath } = Astro.props;
const menuItems = [
  { href: '/', label: 'QUIEN' },
  { href: '/proyectos', label: 'PROYECTOS' },
  { href: '/clases', label: 'CLASES' },
  { href: '/blog', label: 'BLOG' }

];
---
<header>
    <div class="row my-5">
        <div class="col-2 col-md-1">
            <div class="carlos-wrapper">
                <Image src={carlosProfileImage} class="carlos carlos-default" alt="Carlos" />
                <Image src={carlosHoverImage} class="carlos carlos-hover" alt="Carlos" />
            </div>
        </div>
        <div class="col-10">
            <h2 class="bold title">Carlos Miguel Guevara</h2>
            <nav id="main">
                <ul>
                 {menuItems.map((item) => (
                    <li>
                        <a
                        href={item.href}
                        class:list={[
                            'menu-link',
                            { 'active': currentPath === item.href }
                        ]}
                        >
                        {item.label}
                        </a>
                    </li>
                    ))}
                </ul>
            </nav>
        </div>
    </div>
</header>
<style>
.carlos-wrapper {
    position: relative;
    width: 80px;
    height: 80px;
}
.carlos{
    position: absolute;
    width:80px;
    height:80px;
    object-fit: cover;
    border-radius: 5px;
    border:1px solid #e7e7e7;
    padding:4px;
    transition: opacity 0.3s ease;
}
.carlos-hover { opacity: 0; }
.carlos-wrapper:hover .carlos-default { opacity: 0; }
.carlos-wrapper:hover .carlos-hover { opacity: 1; }
nav#main ul{
    font-size:13px;
    font-weight: 600px;
    list-style: none;
    display: flex;
    flex-direction: row;
    margin:0; padding: 0;

}
nav#main a{
  color:#8795a1;
  text-decoration: none;
}
nav#main a:hover{
  color: #000;
  font-weight: 600;
}
nav#main a.active{
  color: #000;
  font-weight: 600;
}
li{ margin-right:20px}
</style>