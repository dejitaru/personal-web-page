---
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <title>Carlos Miguel Guevara</title>
        <meta name="description" content="Carlos Miguel Guevara |Experienced Senior Software Developer specializing in scalable solutions, clean code, and modern development practices. Delivering high-quality, maintainable software for long-term success." />
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@100;300;700&display=swap" rel="stylesheet">
        <!-- Global site tag (gtag.js) - Google Analytics -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-SD2QESDRRX"></script>
        <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-SD2QESDRRX');
        </script>
    </head>
	<body>
		<div class="page-content">
			<slot />
		</div>
		<footer>hecho con <span class="flap-word">amor</span>, <span class="flap-word">café</span> y <span class="flap-word">claude</span></footer>

		<script>
			const pool = ['amor', 'café', 'claude', 'lágrimas', 'cerveza', 'fé', 'código', 'codex', 'magia'];
			const spans = Array.from(document.querySelectorAll<HTMLElement>('.flap-word'));
			const current = spans.map(s => s.textContent!);
			let turn = 0;

			function flipWord(el: HTMLElement, newWord: string) {
				el.style.transition = 'transform 0.1s ease-in';
				el.style.transform = 'perspective(200px) rotateX(-90deg)';
				setTimeout(() => {
					el.textContent = newWord;
					el.style.transition = 'transform 0.15s ease-out';
					el.style.transform = 'perspective(200px) rotateX(0deg)';
				}, 110);
			}

			setInterval(() => {
				const pos = turn % 3;
				turn++;
				const available = pool.filter(w => !current.includes(w));
				const newWord = available[Math.floor(Math.random() * available.length)];
				current[pos] = newWord;
				flipWord(spans[pos], newWord);
			}, 2000);
		</script>
	</body>
</html>

<style>
body{
    font-family: 'Roboto', sans-serif;
    letter-spacing: .1em;
    background-image: url(../assets/background.svg);
    background-repeat: repeat;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}
.page-content {
    flex: 1;
}
.bold{font-weight: 800;}
.title{font-size: 1.875rem;}
.subtitle { font-size:1.5rem;}

p{font-size: 1rem; line-height: 1.5rem;}
.content a { color:#000; font-weight: bold;}
.content p {margin-bottom:30px; font-size:1.1rem}

footer {
    text-align: center;
    font-size: 0.75rem;
    color: #8795a1;
    padding: 2rem 0 1rem;
}
.flap-word {
    display: inline-block;
}

/*blog*/
.entry{margin-bottom:16px}
.entry-title{font-size:0.75rem}
.entry a{text-decoration: none;}
.entry a:hover{ text-decoration: underline;}
</style>