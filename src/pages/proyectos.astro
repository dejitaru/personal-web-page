---
import Welcome from '../components/Welcome.astro';
import Layout from '../layouts/Layout.astro';
import Menu from '../components/Menu.astro';
---

<Layout>
    <div class="container">
        <div class="row">
            <Menu currentPath="/proyectos"/>
            <main>
                <div class="row">
                    <div class="col-1"></div>
                    <div class="col-10 col-md-7 content">
                        <h4 class="bold text-3">BLOGNREADY | 2025 <span class="status-badge">activo</span></h4>
                        <p>Es un CMS rápido usado como alternativa al pesado Wordpress. 10 clientes lo usan, teniendo el más grande 15,000 visitas al dia.</p>                        
                        <h4 class="bold text-3">BOOKNREADY | 2024 <span class="status-badge">activo</span></h4>
                        <p>Es una plataforma para administración de clases de pilates que incluye compra de planes, inscripción y cancelación de clases. Escríbeme si quieres ver un demo.</p>
                        <h4 class="bold text-3">LMSREADY | 2020 <span class="status-badge">activo</span></h4>
                        <p>Es un LMS(Learning managment system) pensando para las empresas donde involucra a recursos humanos, personal, departamente de sistemas y administradores. Ha sido usado por más de 6000 personas y es un proyecto activo. Escríbeme si quieres ver un demo.</p>
                    </div>
                </div>
            </main>
        </div>
    </div>
</Layout>

<style>
.status-badge {
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #4caf7d;
    border: 1px solid #4caf7d;
    border-radius: 20px;
    padding: 2px 8px;
    vertical-align: middle;
    opacity: 0.8;
}
</style>
